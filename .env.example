# Example environment variables for Newsletter Project

# Netlify site ID (used in GitHub Actions workflow)
NETLIFY_SITE_ID=your-site-id-here

# Netlify auth token (from Netlify user settings → API tokens)
NETLIFY_AUTH_TOKEN=your-auth-token-here

# Optional: API keys for external services
NEWSLETTER_API_KEY=your-api-key-here
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@example.com
EMAIL_SMTP_PASS=your-password-here
